* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: #000; color: #fff; font-family: Inter, Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
.app { min-height: 100vh; background: #000; color: #fff; }
.container { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }
.hero { position: relative; overflow: hidden; padding: 72px 0; }
.heroGlow { position: absolute; inset: 0; background: radial-gradient(circle at 30% 20%, rgba(249,115,22,.26), transparent 36%), radial-gradient(circle at 80% 10%, rgba(255,255,255,.08), transparent 26%); pointer-events: none; }
.heroGrid { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
.eyebrow { color: #fb923c; font-size: 13px; font-weight: 800; letter-spacing: .28em; margin: 0 0 18px; }
h1 { font-size: clamp(42px, 6vw, 76px); line-height: 1.05; margin: 0; letter-spacing: -.04em; }
h2 { font-size: clamp(30px, 4vw, 46px); line-height: 1.15; margin: 0; letter-spacing: -.03em; }
h3 { margin: 0; font-size: 22px; }
.lead { color: #d4d4d8; font-size: 20px; line-height: 1.65; max-width: 620px; margin: 28px 0 0; }
.buttonRow { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
.primaryBtn, .secondaryBtn, .fullBtn { border: 0; cursor: pointer; border-radius: 18px; padding: 16px 28px; font-weight: 800; }
.primaryBtn, .fullBtn { background: #f97316; color: #fff; }
.secondaryBtn { border: 1px solid #52525b; color: #fff; background: transparent; }
.heroCard, .calcBox, .formBox { border: 1px solid rgba(249,115,22,.28); background: rgba(9,9,11,.86); border-radius: 34px; padding: 28px; box-shadow: 0 24px 80px rgba(0,0,0,.45); }
.heroCardTop { display: flex; justify-content: space-between; align-items: center; gap: 24px; }
.muted { color: #a1a1aa; margin: 0; }
.mutedLight { color: #d4d4d8; margin: 8px 0 0; }
.mainPrice { font-size: clamp(44px, 5vw, 64px); line-height: 1; font-weight: 900; color: #fb923c; margin: 12px 0 0; letter-spacing: -.04em; }
.heroIcon { width: 84px; height: 84px; color: #fb923c; flex: none; }
.miniGrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 34px; text-align: center; }
.miniBox { background: #18181b; border-radius: 18px; padding: 18px 10px; }
.miniBox strong { display: block; font-size: 28px; }
.miniBox span { display: block; color: #a1a1aa; font-size: 14px; margin-top: 6px; }
.section { padding: 58px 0; }
.featureGrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 34px; }
.featureCard, .darkCard { border: 1px solid rgba(249,115,22,.18); background: #09090b; border-radius: 28px; padding: 28px; }
.iconBox { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; color: #fb923c; background: rgba(249,115,22,.14); border-radius: 18px; margin-bottom: 22px; }
.featureCard p { color: #a1a1aa; line-height: 1.7; font-size: 15px; }
.compareGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.darkCard { border-color: #27272a; }
.list { margin-top: 30px; color: #d4d4d8; line-height: 1.8; font-weight: 600; }
.outlineBox { border: 1px solid #3f3f46; border-radius: 20px; padding: 22px; margin-top: 30px; }
.outlineBox strong { display: block; color: #fb923c; font-size: 40px; margin-top: 10px; }
.orangeCard { background: #f97316; color: #080808; border-radius: 28px; padding: 30px; }
.orangeCard h2 { font-weight: 950; }
.blackText { color: #111; }
.orangeInner { background: rgba(0,0,0,.16); border-radius: 20px; padding: 22px; margin-top: 30px; }
.orangeInner strong { display: block; font-size: 60px; margin-top: 8px; }
.titleLine { display: flex; align-items: center; gap: 12px; margin-bottom: 32px; }
.orangeIcon { color: #fb923c; width: 32px; height: 32px; }
.calcGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; }
label { display: block; color: #a1a1aa; margin-bottom: 10px; font-size: 14px; }
input, select { width: 100%; border: 1px solid #3f3f46; outline: none; background: #000; color: #fff; border-radius: 18px; padding: 16px; }
input:focus, select:focus { border-color: #fb923c; }
.calcGrid input { font-size: 28px; font-weight: 900; }
.smallText { color: #71717a; font-size: 13px; margin-top: 12px; line-height: 1.6; }
.resultGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.result { background: #000; border: 1px solid #27272a; border-radius: 18px; padding: 18px; }
.result.highlight { background: #f97316; color: #000; border-color: #f97316; }
.result p { margin: 0; color: #a1a1aa; font-size: 14px; }
.result.highlight p { color: rgba(0,0,0,.7); }
.result strong { display: block; font-size: 25px; margin-top: 8px; }
.result span { display: block; color: #a1a1aa; font-size: 12px; margin-top: 6px; }
.appGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
.checkList { display: grid; gap: 16px; margin-top: 32px; color: #d4d4d8; }
.checkList div { display: flex; align-items: center; gap: 12px; }
.checkList svg { color: #fb923c; flex: none; }
.phoneMock { width: min(100%, 360px); margin: 0 auto; background: #09090b; border: 1px solid #3f3f46; border-radius: 42px; padding: 16px; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
.phoneScreen { background: #000; border-radius: 32px; padding: 24px; }
.phoneTop { display: flex; justify-content: space-between; align-items: center; margin-bottom: 28px; color: #a1a1aa; }
.phoneTop svg { color: #fb923c; }
.phoneScreen strong { display: block; color: #fb923c; font-size: 40px; margin-top: 10px; }
.phoneItem { background: #18181b; border-radius: 16px; padding: 16px; margin-top: 12px; color: #e4e4e7; }
.formBox { max-width: 860px; }
.formGrid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.fullBtn { width: 100%; margin-top: 24px; }
.center { text-align: center; }
@media (max-width: 900px) { .heroGrid, .compareGrid, .calcGrid, .appGrid { grid-template-columns: 1fr; } .featureGrid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .container { width: min(100% - 26px, 1180px); } .hero { padding: 48px 0; } .featureGrid, .resultGrid, .formGrid { grid-template-columns: 1fr; } .miniGrid { grid-template-columns: 1fr; } .mainPrice { font-size: 42px; } .heroCardTop { align-items: flex-start; } }
